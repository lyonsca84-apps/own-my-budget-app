# Copy this file to .env and fill in real values. Never commit .env.
# Root-level secrets for server-side code (Supabase Edge Functions, etc).
# Do NOT put secret keys like this in apps/mobile/.env with an EXPO_PUBLIC_
# prefix — that ships the key inside the client app bundle where anyone
# can extract it.

# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# openrouter.ai/keys — never paste into a chat with an AI assistant, including
# this one. Run `npm run setup:openrouter` instead of pasting it here by hand —
# that script validates the key and writes it to your local .env for you.
# See docs/ai-orchestrator-setup.md.
OPENROUTER_API_KEY=

# AI orchestration feature flags — all default OFF/conservative if unset.
# See docs/ai-orchestrator-setup.md for what each one gates.
JEV_ORCHESTRATOR_ENABLED=false
JEV_VOICE_ROUTING_ENABLED=false
JEV_ONBOARDING_ENABLED=false
AI_ORCHESTRATOR_MAX_LOOPS=3

# Budget Buddy voice (tap-to-talk). Uses the same server-side
# OPENROUTER_API_KEY above — customers never need a key of their own.
# Off until BUDDY_VOICE_ENABLED is exactly "true". Every other value below
# is optional and shown at its default. See docs/voice-setup.md.
BUDDY_VOICE_ENABLED=false
BUDDY_VOICE_STT_MODEL=openai/gpt-4o-mini-transcribe
BUDDY_VOICE_TTS_MODEL=microsoft/mai-voice-2.1-flash
BUDDY_VOICE_TTS_VOICE=en-US-Harper:MAI-Voice-2.1-Flash
BUDDY_VOICE_TTS_FORMAT=mp3
BUDDY_VOICE_MAX_RECORDING_SECONDS=60
BUDDY_VOICE_MAX_REPLY_CHARS=600
BUDDY_VOICE_RATE_LIMIT_PER_MINUTE=6
BUDDY_VOICE_MONTHLY_BUDGET_USD=25
BUDDY_VOICE_MONTHLY_TURNS_FREE=0
BUDDY_VOICE_MONTHLY_TURNS_GUIDED=20
BUDDY_VOICE_MONTHLY_TURNS_BUDGET_BUDDY=100
BUDDY_VOICE_MONTHLY_SPOKEN_REPLIES_FREE=0
BUDDY_VOICE_MONTHLY_SPOKEN_REPLIES_GUIDED=40
BUDDY_VOICE_MONTHLY_SPOKEN_REPLIES_BUDGET_BUDDY=200
