# Copy to .env.local and fill in. Never commit real .env files.
# Only public, browser-safe values belong here — Vite exposes every VITE_ variable
# to the page. The Supabase service-role key and all Stripe secret/webhook keys
# live ONLY in Supabase Edge Function secrets (see docs/stripe-setup.md).

# Supabase project settings > API > Project URL
VITE_SUPABASE_URL=
# Supabase project settings > API > Publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=
# Optional: the Own My Budget web app URL, for "Open my budget" buttons
VITE_APP_URL=
# Optional: support inbox shown on Contact / Privacy / Terms / Accessibility
VITE_SUPPORT_EMAIL=
