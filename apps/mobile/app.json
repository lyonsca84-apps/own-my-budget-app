{
  "expo": {
    "name": "Own My Budget",
    "slug": "own-my-budget",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/design-system/brand/app-icon.png",
    "scheme": "ownmybudget",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/design-system/brand/app-icon.png",
      "bundleIdentifier": "com.ownmybudget.app",
      "supportsTablet": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/design-system/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F6F3",
          "image": "./assets/design-system/brand/logo-vertical-lockup.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Own My Budget uses your photos to scan receipts and pantry items.",
          "cameraPermission": "Own My Budget uses your camera to scan receipts and pantry items."
        }
      ],
      "expo-sharing",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
